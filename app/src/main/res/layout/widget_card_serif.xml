<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A9B8DB" android:maxLines="1" />
    <TextClock android:fontFamily="serif" android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="42sp" android:textColor="#FFFFFF" android:visibility="gone" />
    <AnalogClock android:id="@+id/widget_analog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:contentDescription="@string/widget_analog_description" />
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/widget_image_description" android:visibility="gone" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="27sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="3" android:ellipsize="end" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#CBD5EB" android:layout_marginTop="5dp" android:maxLines="4" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_media_controls" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
        <TextView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/widget_previous_symbol" android:gravity="center" android:textSize="20sp" android:textColor="#FFFFFF" android:contentDescription="@string/widget_previous_description" />
        <TextView android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/widget_play_symbol" android:gravity="center" android:textSize="24sp" android:textColor="#FFFFFF" android:contentDescription="@string/widget_play_description" />
        <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="@string/widget_next_symbol" android:gravity="center" android:textSize="20sp" android:textColor="#FFFFFF" android:contentDescription="@string/widget_next_description" />
    </LinearLayout>
</LinearLayout>