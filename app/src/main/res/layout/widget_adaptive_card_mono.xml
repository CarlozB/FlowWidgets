<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@string/widget_image_description" />
<AnalogClock android:id="@+id/widget_analog" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:contentDescription="@string/widget_analog_description" />
<TextClock android:id="@+id/widget_clock" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:singleLine="true" android:gravity="center" android:fontFamily="monospace" />
<TextClock android:id="@+id/widget_date" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:singleLine="true" android:gravity="center" android:fontFamily="monospace" />
<TextClock android:id="@+id/widget_zone_1" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:singleLine="true" android:gravity="center" android:fontFamily="monospace" />
<TextClock android:id="@+id/widget_zone_2" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:singleLine="true" android:gravity="center" android:fontFamily="monospace" />
<TextClock android:id="@+id/widget_zone_3" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:layout_gravity="top|left" android:singleLine="true" android:gravity="center" android:fontFamily="monospace" />
<LinearLayout android:id="@+id/widget_media_controls" android:layout_width="1dp" android:layout_height="1dp" android:layout_gravity="bottom|left" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
<ImageView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/widget_previous_description" />
<ImageView android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/widget_play_description" />
<ImageView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/widget_next_description" />
</LinearLayout>
<FrameLayout android:id="@+id/widget_hits" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
